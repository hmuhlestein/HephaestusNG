#!/usr/bin/env bash
# Protected `git` wrapper for CLI agent sessions.
#
# In review mode, landing a feature's work on a protected branch (main,
# master) is blocked unless the feature has been approved (signaled by
# .hephaestus/review_approved marker file). This covers both `git merge`
# and `git push` targeting a protected branch directly -- a push-to-main
# achieves the same "land on main before review" outcome as a merge and
# was previously not caught at all.
#
# All other git commands pass through unmodified.
#
# This is a hard technical guardrail against the NORMAL, non-adversarial
# agent behavior instructed against in git_commit_push.yaml (same threat
# model as the `rm` wrapper in this same directory) -- it is not hardened
# against an agent deliberately evading it (e.g. invoking git by absolute
# path, or pushing to an upstream configured to point at main under a
# differently-named local branch). Closing those requires server-side
# branch protection, not a PATH trick.

set -euo pipefail

# Find the real git binary. Skipping past this wrapper's own directory
# is not enough: a second copy of this same wrapper can legitimately be
# on PATH too (e.g. another worktree's scripts/agent-safe-bin, or a
# leftover PATH entry from a different checkout) -- picking that up as
# "real_git" would recurse into a wrapper instead of true git, causing
# either double-enforcement (this wrapper decides pass, but the other
# copy blocks anyway on its own, possibly stale, logic) or an
# unintended bypass, depending on directory order. The real git binary
# is always a compiled executable; every wrapper here is a bash script
# starting with a shebang line -- checking for that distinguishes them
# regardless of how many wrapper copies are stacked on PATH.
real_git=""
IFS=':' read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
    if [[ "$dir" == "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" ]]; then
        continue
    fi
    candidate="$dir/git"
    if [[ -x "$candidate" ]]; then
        first_two_bytes="$(head -c 2 "$candidate" 2>/dev/null || echo "")"
        if [[ "$first_two_bytes" == "#!" ]]; then
            continue
        fi
        real_git="$candidate"
        break
    fi
done
if [[ -z "$real_git" ]]; then
    real_git="/usr/bin/git"
fi

protected_branches="main master"

# First non-flag argument is the subcommand.
subcommand=""
for arg in "$@"; do
    case "$arg" in
        -*) continue ;;
        *) subcommand="$arg"; break ;;
    esac
done

blocked_reason=""

if [[ "$subcommand" == "merge" ]]; then
    # `git merge` merges INTO the current branch -- only block when that
    # target is main/master itself. Merging one throwaway branch into
    # another (worktree agent branches, test scratch repos) is unrelated
    # to "landing on main before review" and must pass through.
    current_branch="$("$real_git" symbolic-ref --short HEAD 2>/dev/null || echo "")"
    for b in $protected_branches; do
        if [[ "$current_branch" == "$b" ]]; then
            blocked_reason="git merge into $b"
        fi
    done
elif [[ "$subcommand" == "push" ]]; then
    # --all/--mirror can push a local main/master along with everything
    # else even with no refspec naming it explicitly -- block outright.
    for arg in "$@"; do
        case "$arg" in
            --all|--mirror)
                blocked_reason="git push $arg"
                ;;
        esac
    done

    # Collect non-flag tokens after "push" (remote name and/or refspecs).
    push_tokens=()
    seen_push=0
    for arg in "$@"; do
        if [[ "$seen_push" -eq 0 ]]; then
            [[ "$arg" == "push" ]] && seen_push=1
            continue
        fi
        case "$arg" in
            -*) continue ;;
        esac
        push_tokens+=("$arg")
    done

    # Each token is either a remote name or a refspec (local:remote, or a
    # bare branch name pushing to the same-named remote branch). The
    # target branch is what's after ':', or the whole token if there's
    # no colon. Checking every token (including what's probably the
    # remote name) is harmless -- "origin" never equals "main".
    for tok in "${push_tokens[@]}"; do
        target="${tok##*:}"
        for b in $protected_branches; do
            if [[ "$target" == "$b" || "$target" == "refs/heads/$b" ]]; then
                blocked_reason="git push targeting $b"
            fi
        done
    done

    # No explicit refspec at all (`git push` / `git push origin`) pushes
    # the CURRENT branch to its configured upstream -- block if the
    # current branch itself is main/master. (Does not catch a
    # differently-named local branch whose upstream was separately
    # configured to point at main -- see header.)
    if [[ -z "$blocked_reason" ]]; then
        current_branch="$("$real_git" symbolic-ref --short HEAD 2>/dev/null || echo "")"
        for b in $protected_branches; do
            if [[ "$current_branch" == "$b" ]]; then
                blocked_reason="git push of current branch ($b)"
            fi
        done
    fi
fi

if [[ -n "$blocked_reason" ]]; then
    # Walk up to find the worktree root (contains .hephaestus/). This
    # guardrail only protects THIS project's main/master -- a repo with
    # no .hephaestus/ anywhere above cwd isn't a Hephaestus-managed
    # project at all (e.g. a scratch git repo a test creates under
    # /tmp via tempfile.mkdtemp(), which commonly also defaults to a
    # branch named "main"); pass those through unconditionally instead
    # of matching on branch name alone.
    hephaestus_dir=""
    check_dir="$PWD"
    while [[ "$check_dir" != "/" ]]; do
        if [[ -d "$check_dir/.hephaestus" ]]; then
            hephaestus_dir="$check_dir/.hephaestus"
            break
        fi
        check_dir="$(dirname "$check_dir")"
    done

    if [[ -n "$hephaestus_dir" && ! -f "$hephaestus_dir/review_approved" ]]; then
        echo "BLOCKED: $blocked_reason is not allowed until the feature has been reviewed and approved." >&2
        echo "In review mode, create a PR instead. The merge/push will happen after" >&2
        echo "human approval creates the .hephaestus/review_approved marker." >&2
        echo "" >&2
        echo "To create a PR: gh pr create --title 'feat: ...' --body '...'" >&2
        exit 1
    fi
fi

exec "$real_git" "$@"
