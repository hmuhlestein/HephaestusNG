diff --git a/src/mcp/autopilot_api.py b/src/mcp/autopilot_api.py
index 1673a2e..1de327b 100644
--- a/src/mcp/autopilot_api.py
+++ b/src/mcp/autopilot_api.py
@@ -1054,14 +1054,35 @@ async def rerun_design(request: dict):
                     .filter(Task.workflow_id.in_(design_wf_ids), Task.status.in_(["assigned", "in_progress"]))
                     .all()
                 )
-                stuck_agent_ids = [t.assigned_agent_id for t in stuck_tasks if t.assigned_agent_id]
+                stuck_agent_ids = {t.assigned_agent_id for t in stuck_tasks if t.assigned_agent_id}
                 for t in stuck_tasks:
                     t.status = "pending"
                     t.assigned_agent_id = None
                     t.failure_reason = None
 
-                if stuck_agent_ids:
-                    for agent in db.query(Agent).filter(Agent.id.in_(stuck_agent_ids)).all():
+                # Also catch agents whose Task has already moved past
+                # assigned/in_progress (done, needs_work, under_review, ...)
+                # but whose Agent row is still alive (idle/starting/working)
+                # -- deriving the agent set solely from stuck_tasks above
+                # misses these, since they own no Task in that status
+                # filter. Matched via Agent.current_task_id against ALL of
+                # this design's task ids (not just the currently-stuck
+                # ones), the same field terminate_agent_direct's own safety
+                # net keys off. Without this, such an agent survives the
+                # rerun untouched while Step 2b regenerates the design
+                # underneath it, and can still call back into the pipeline
+                # against now-stale task/phase state.
+                design_task_ids = [t.id for t in db.query(Task.id).filter(Task.workflow_id.in_(design_wf_ids)).all()]
+                stray_agent_ids = {
+                    a.id
+                    for a in db.query(Agent)
+                    .filter(Agent.status.in_(["working", "starting", "idle"]), Agent.current_task_id.in_(design_task_ids))
+                    .all()
+                } if design_task_ids else set()
+
+                all_agent_ids = stuck_agent_ids | stray_agent_ids
+                if all_agent_ids:
+                    for agent in db.query(Agent).filter(Agent.id.in_(all_agent_ids)).all():
                         agent.status = "terminated"
                         agent.current_task_id = None
                         agent.terminated_at = datetime.utcnow()
diff --git a/tests/test_autopilot_api.py b/tests/test_autopilot_api.py
index 4a8b14e..825845a 100644
--- a/tests/test_autopilot_api.py
+++ b/tests/test_autopilot_api.py
@@ -543,6 +543,68 @@ class TestQueueRerun:
             assert target_task.assigned_agent_id is None
             assert target_wf.status == "paused"
 
+    def test_rerun_terminates_idle_agent_whose_task_already_moved_past_in_progress(
+        self, project_client, monkeypatch
+    ):
+        """Regression: Step 2 derived its agent set solely from Tasks still
+        "assigned"/"in_progress" -- an agent with status "idle" (or
+        "starting") whose Task had already moved on (e.g. "done",
+        "needs_work") had no such Task pointing at it, so it was never
+        selected for termination and survived the rerun untouched while
+        Step 2b regenerated the design underneath it, fully orphaned."""
+        client, dirs = project_client
+        project_dir = dirs["project_dir"]
+
+        from src.core.database import (
+            Agent,
+            AutopilotDesign,
+            AutopilotProject,
+            Task,
+            Workflow,
+            get_db,
+        )
+
+        with get_db() as db:
+            db.add(AutopilotProject(id="proj-idle", name="idle", base_dir=str(project_dir)))
+            db.add(AutopilotDesign(
+                id="des-idle", project_id="proj-idle", filename="01-auth.md", name="Auth", status="active",
+            ))
+            db.add(Workflow(
+                id="wf-idle-feature", name="autopilot", phases_folder_path="/tmp",
+                status="active", definition_id="autopilot", design_id="des-idle",
+            ))
+            db.add(Task(
+                id="task-idle-done", workflow_id="wf-idle-feature", phase_id=None,
+                raw_description="x", done_definition="x", status="done", assigned_agent_id=None,
+            ))
+            db.add(Agent(id="agent-idle", status="idle", current_task_id="task-idle-done", cli_type="claude", system_prompt="x"))
+
+        fake_service = Mock()
+        fake_service.running = False
+        fake_service.start = AsyncMock(return_value={"started": True})
+        fake_service.stop = AsyncMock(return_value={"stopped": True})
+        monkeypatch.setattr(
+            "src.autopilot.service.get_autopilot_service", lambda project_id: fake_service
+        )
+        monkeypatch.setattr(
+            "src.autopilot.orchestrator._resolve_project_id", lambda project_path: "proj-idle"
+        )
+        monkeypatch.setattr(
+            "src.autopilot.orchestrator._get_or_create_project_id",
+            lambda project_path: "proj-idle",
+        )
+
+        resp = client.post(
+            "/api/autopilot/queue/rerun",
+            json={"filename": "01-auth.md", "project_path": str(project_dir)},
+        )
+        assert resp.status_code == 200, resp.text
+
+        with get_db() as db:
+            idle_agent = db.query(Agent).filter_by(id="agent-idle").first()
+            assert idle_agent.status == "terminated", "idle agent orphaned from this design must be terminated on rerun"
+            assert idle_agent.current_task_id is None
+
 
