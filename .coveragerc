[run]
source = src
omit =
    tests/*
    frontend/*
    scripts/*
    .worktrees/*
    lib/*
    */__pycache__/*

[report]
show_missing = true
precision = 1
# The sole enforcement point -- pytest-cov reads this value directly and
# builds it before any pytest_configure hook can run (it captures
# --cov-fail-under during pytest_load_initial_conftests), so nothing in
# conftest.py can override it at runtime. Keep this in sync by hand with
# hephaestus_config.yaml's testing.coverage_floor when raising the floor;
# conftest.py's pytest_configure hook only exposes that YAML value on
# config for other scripts/plugins to read, it does not enforce it.
fail_under = 20
exclude_lines =
    pragma: no cover
    def __repr__
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
