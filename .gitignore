# Spec Kit's per-agent command output — regenerated locally by `specify init`.
# spec-kit skills are installed globally (~/.claude/skills/), not per-repo;
# .specify/ (templates, constitution, scripts) is intentionally NOT listed
# here and stays tracked, since Spec Kit's own design commits and shares it
# like config/workflows/ — only feature.json is machine-local, and Spec Kit
# already excludes that itself via .specify/.gitignore. That file still
# works read from the working tree even though it's CLI-managed boilerplate
# we don't want versioned here, so it's excluded too.
.claude/skills/
.specify/.gitignore

# Hephaestus local data
.hephaestus/
.pi-subagents/
extensions/*/node_modules/
.pi/
