#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ "$SCRIPT_DIR" == */.venv/bin ]]; then
  HEPH_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
  HEPH_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
export PYTHONPATH="${HEPH_DIR}${PYTHONPATH:+:$PYTHONPATH}"
exec "${HEPH_DIR}/.venv/bin/python" -m src.cli.main "$@"
